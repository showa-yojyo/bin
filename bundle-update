#!/bin/bash
# Description: run `bundle update` and commit Gemfile.lock if it is updated.

set -o errexit -o nounset -o pipefail

declare -r dir=${1:?Usage: ${0##*/} PROJECT_DIRECTORY}
declare -r target=Gemfile.lock

builtin cd "$dir" || exit 1

# Address run from cron(8)
if [[ ! -v SSH_AGENT_PID || ! -v SSH_AUTH_SOCK ]]; then
    echo "Load SSH variables" >&2
    source ~/.keychain/$(hostname)-sh || exit 1
fi

declare -r git=/usr/bin/git
if ! "$git" diff --staged --quiet; then
    echo "There are files staged for commit." >&2
    exit 1
fi

if [[ ! -v GEM_HOME ]]; then
    export GEM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/gem"
fi

if [[ ! -v GEM_SPEC_CACHE ]]; then
    export GEM_SPEC_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/gem"
fi

"$GEM_HOME/bin/bundle" update

# Test if Gemfile.lock has been changed.
if "$git" diff --quiet "$target"; then
    echo "No changes" >&2
    exit 0
fi

# There must be no staged file now.
"$git" switch --quiet master
"$git" add --update "$target"

# There must be Gemfile.lock staged.
"$git" commit --message "${target}: update vendored gems" --quiet
echo "Update Gemfile.lock" >&2

# XXX
if (( $("$git" rev-list --count "origin/master..HEAD") == 1 )); then
    "$git" push origin master
fi
