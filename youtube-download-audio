#!/bin/bash
# description: download an audio file (mp3) from YouTube

set -o errexit -o nounset -o pipefail

function main
{
    local -r video_url="${1:?Usage: $BASH_ARGV0 VIDEO_URL}"
    local -ar options=(-q --no-playlist -t mp3 --js-runtimes node)

    yt-dlp "${options[@]}" -o "%(id)s-%(title)s.%(ext)s" "$video_url"
}

main "$@"
